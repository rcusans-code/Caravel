# systemd --user unit for the TypeScript keeper (scripts/keeper/src/keeper.ts):
# check_margin, default and liquidate on every repo, so a lender is paid even
# when the borrower never repays. Install (see scripts/README.md):
#   mkdir -p ~/.local/lib/caravel/keeper
#   cp -r scripts/keeper/{package.json,package-lock.json,tsconfig.json,src} ~/.local/lib/caravel/keeper/
#   (cd ~/.local/lib/caravel/keeper && npm ci --silent)
#   install -Dm600 .env ~/.local/lib/caravel/.env
#   install -Dm755 scripts/caravel-alert.sh ~/.local/lib/caravel/caravel-alert.sh
#   install -Dm644 scripts/caravel-alert@.service ~/.config/systemd/user/caravel-alert@.service
#   install -Dm644 scripts/caravel-keeper.service ~/.config/systemd/user/caravel-keeper.service
#   systemctl --user daemon-reload && systemctl --user enable --now caravel-keeper
# The keeper and its .env are copied out of the checkout so a branch switch or
# a merge conflict in the tracked .env cannot repoint or break the service.
# Re-run the `install -Dm600 .env` line after every redeploy: the keeper sees
# REPO_ID change in its copy, exits, and Restart= reloads it on the new IDs.
# NAV is kept fresh by caravel-nav-keeper.service, so no --refresh-nav here.
# A stuck payout logs an ALERT line and runs ALERT_CMD; a crash loop past the
# start limit fails the unit and OnFailure= sends the same alert.
[Unit]
Description=Caravel keeper (check_margin, default, liquidate on every repo every 10 s)
After=network-online.target caravel-nav-keeper.service
Wants=network-online.target
OnFailure=caravel-alert@%n.service
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
Environment=ENV_FILE=%h/.local/lib/caravel/.env
Environment=ALERT_CMD=%h/.local/lib/caravel/caravel-alert.sh
WorkingDirectory=%h/.local/lib/caravel/keeper
ExecStart=/usr/bin/node node_modules/tsx/dist/cli.mjs src/keeper.ts
Restart=always
RestartSec=10
# tsx forwards SIGTERM to the keeper child and exits 143 (128 + SIGTERM).
# Tell systemd 143 is an expected clean exit on service stop.
SuccessExitStatus=143

[Install]
WantedBy=default.target
